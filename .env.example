# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.
# Dev: SQLite. Deploy (Vercel): chuỗi kết nối Postgres của Neon/Supabase và đổi provider trong prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Khóa ký JWT phiên đăng nhập – tối thiểu 32 ký tự ngẫu nhiên.
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
